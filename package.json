{
  "name": "stellar-splash-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "format:check": "npx prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "format": "npx prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "precommit": "npm run typecheck && npm test",
    "prepare": "git config core.hooksPath .githooks || true",
    "verify:all": "node scripts/verify-all.cjs",
    "analyze": "node scripts/analyze-bundle.cjs"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^12.3.0",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^25.13.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^2.1.8"
  }
}
